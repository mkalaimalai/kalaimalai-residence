{
  "name": "kalaimalai-residence",
  "version": "0.1.0",
  "private": true,
  "//workspaces": "apps/mobile is deliberately NOT a member: React Native needs React 18 and Next needs React 19, so npm splits Expo across two node_modules and Metro breaks. It installs on its own and consumes the packages via file: deps.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "dev:all": "./scripts/dev.sh all",
    "dev:api": "./scripts/dev.sh api",
    "dev": "npm run dev --workspace @kr/web",
    "build": "npm run build --workspace @kr/web",
    "start": "npm run start --workspace @kr/web",
    "lint": "npm run lint --workspace @kr/web",
    "typecheck": "npm run typecheck --workspace @kr/web",
    "verify": "npm run verify --workspace @kr/web",
    "verify:api": "npm run verify:api --workspace @kr/web",
    "export:seed": "npm run export:seed --workspace @kr/web",
    "typecheck:all": "npm run typecheck --workspaces --if-present && npm --prefix apps/mobile run typecheck",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:install": "npm --prefix apps/mobile install",
    "dev:admin": "npm run dev --workspace @kr/admin",
    "build:admin": "npm run build --workspace @kr/admin",
    "typecheck:admin": "npm run typecheck --workspace @kr/admin"
  }
}
