# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Workspaces keep their own node_modules for anything npm can't hoist.
node_modules/
apps/*/.expo/
apps/*/expo-env.d.ts
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/
apps/*/tsconfig.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!api/.env.example

# python backend (api/)
**/.venv/
**/__pycache__/
*.pyc
# generated seed bridge — regenerate with `npm run export:seed`
apps/api/scripts/seed.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source design assets — kept local, not published
artifacts/

# Internal business strategy — keep local, do not publish on the public repo
docs/business-brainstorm.html

# Google Cloud service-account keys. These are live credentials — a committed key is a
# compromised key, and this repo is published. Keep them out of the tree if you can; if
# one must live here, it matches these patterns.
*-service-account*.json
*.iam.gserviceaccount.com.json
ai-builder-*.json
gcp-*.json
service-account*.json
credentials.json

# Google OAuth client + user token — live credentials, never commit
.google-oauth-client.json
.google-oauth-token.json
api/.google-oauth-client.json
api/.google-oauth-token.json

# Xcode (apps/ios). The .xcodeproj itself IS tracked — it is the build definition — but
# per-user state inside it is not: xcuserdata holds window layout, breakpoints and the
# personal scheme list, and would conflict on every pull. The shared scheme lives in
# xcshareddata and is tracked.
xcuserdata/
*.xcuserstate
DerivedData/
*.xcworkspace/xcuserdata/

# Speckle spike scratch (docs/speckle-spike.md) — delete when the spike concludes
apps/api/scripts/spike_speckle.py
