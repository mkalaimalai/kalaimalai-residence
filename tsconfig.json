{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // Workspace packages are symlinked into node_modules, but tsc will not pick up
      // their TypeScript sources from there — map them to the real files.
      "@kr/contracts": ["./packages/contracts/src/index.ts"],
      "@kr/api-client": ["./packages/api-client/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `apps/*` are separate workspaces with their own tsconfig and their own React types
  // (the mobile app is on React 18 / react-native types). Compiling them under the web
  // app's settings pulls in two copies of @types/react and fails on the mismatch.
  "exclude": ["node_modules", "apps"]
}
